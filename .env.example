# Copy to .env in the directory where you launch deposition-toolkit.
# Environment variables override this file; command-line options override both.

# CCD allocation and CVS use the same component dictionary checkout.
UNUSED_CCD_FILE_PATH=/nfs/public/services/onedep_gpfs/data/production/reference/id_codes/unusedCodes.lst
CCD_CVS_PATH=/nfs/public/services/onedep_gpfs/data/production/reference/components/ligand-dict-v3

# Annotation tools. ANNOTATE_BIN is optional and defaults to
# <TOOLS_ROOT>/packages/cc-tools-v2/bin/annotateComp.
TOOLS_ROOT=/nfs/public/services/onedep_gpfs/resources/tools/tools-centos-7.9
# ANNOTATE_BIN=/path/to/annotateComp

DEPOSITION_TOOLKIT_WORKROOT=/nfs/public/services/onedep_gpfs/deposition-toolkit-processing
DEPOSITION_ROOT=/nfs/public/services/onedep_gpfs/data/production/deposit
MMCIF_DICTIONARY_PATH=/nfs/public/services/onedep_gpfs/deposition-toolkit-processing/mmcif_pdbx_v50.dic

# Existing OneDep MySQL database used by CCD finalisation.
CCD_DB_HOST=mysql-pdbe-onedep-prod.ebi.ac.uk
CCD_DB_PORT=4437
CCD_DB_USER=pdberead
CCD_DB_PASSWORD=place-holder
CCD_DB_TIMEOUT=30

# Toolkit ledger PostgreSQL database. Used only by ledger operations.
POSTGRES_HOST=pgsql-hlvm-172
POSTGRES_PORT=5432
POSTGRES_USER=pdb_dep
POSTGRES_PASSWORD=place-holder
# Optional: defaults to POSTGRES_USER. Set only if the database name differs.
# POSTGRES_DATABASE=deposition_toolkit
